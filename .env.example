# ---------------------------------------------------------------------------
# Report Automation web app — configuration
#
# Copy this file to `.env` and edit. NEVER commit `.env`.
#     cp .env.example .env
# ---------------------------------------------------------------------------

# --- Who can log in -------------------------------------------------------
# Comma-separated  username:password  pairs. Add as many colleagues as you like.
#     APP_USERS=alice:s3cret,bob:hunter2,office:sharedpass
#
# A password may instead be a bcrypt hash (starts with $2b$) — it is detected
# automatically, so you can avoid storing plaintext:
#     python -c "import bcrypt;print(bcrypt.hashpw(b'mypassword',bcrypt.gensalt()).decode())"
APP_USERS=admin:change-me-now

# --- Session signing ------------------------------------------------------
# Long random string. Changing it logs everyone out.
#     python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to 1 once you are serving over HTTPS (required for the Secure cookie flag),
# i.e. after you put Caddy in front. Leave 0 while testing over plain http://IP.
COOKIE_SECURE=0
# How long a login lasts, in hours.
SESSION_HOURS=12

# --- Capture performance / memory ----------------------------------------
# How many jobs run at the same time. Each job launches CAPTURE_WORKERS
# Chromium processes at ~300-700 MB each, so total RAM is roughly
#     MAX_CONCURRENT_JOBS * CAPTURE_WORKERS * 0.7 GB
# On the Oracle Always Free VM (2 OCPU / 12 GB) use 1 x 2: two browsers is
# ~1.4 GB and the box only has 2 cores, so more will not go faster.
MAX_CONCURRENT_JOBS=1
CAPTURE_WORKERS=2
# The Influencer report uses ONE browser: its follower-count cache is per worker
# process, so a second worker re-fetches the same profiles and pays twice for
# them. It also keeps headroom under a free browser plan's 2-concurrent limit.
INFLUENCER_WORKERS=1

# Hard ceiling on how long one job may run before it is killed (minutes).
JOB_TIMEOUT_MINUTES=90

# --- Upload limits --------------------------------------------------------
MAX_UPLOAD_MB=5
MAX_LINKS=200

# --- Disk retention -------------------------------------------------------
# Finished jobs are deleted after this many days, and oldest-first once the
# jobs folder exceeds MAX_DATA_GB.
RETENTION_DAYS=7
MAX_DATA_GB=5

# --- Shared X capture account (auto sign-in) -------------------------------
# The server signs in to X by itself and regenerates the session file. This is
# what makes a host with an EPHEMERAL disk (Hugging Face Spaces) workable: there
# is no cookie file to keep alive.
#
# Use a DEDICATED / throwaway X account, never a personal one — bulk captures
# can get an account rate-limited or suspended.
X_USERNAME=BilalSh75410617
X_PASSWORD=rahul@643
# X asks for the account's email when it sees a login from an unfamiliar
# machine, which a cloud server always is. Set it.
X_EMAIL=bilal565e@gmail.com
# Only if that account has 2FA turned on (simpler: turn 2FA off on it).
X_TOTP_SECRET=

# --- Browser backend ------------------------------------------------------
# local        launch Chromium in this container/machine (needs ~700 MB per
#              browser; the default, and what the CLI has always done)
# browserless  connect to a remote browser over CDP — required on a free host
#              with ~512 MB RAM, which cannot run Chromium at all
BROWSER_BACKEND=local
# wss://production-sfo.browserless.io?token=YOUR_TOKEN   (treat as a password)
BROWSERLESS_WS=
# Free remote-browser plans allow very few simultaneous browsers. The app
# clamps MAX_CONCURRENT_JOBS x CAPTURE_WORKERS to this rather than erroring.
BROWSER_MAX_CONCURRENCY=2

# --- Durable X session (needed when the host has no disk) ------------------
# none | github
X_STATE_STORE=none
# github: a PRIVATE repo + a fine-grained PAT with Contents:read+write on it
X_STATE_GITHUB_REPO=
X_STATE_GITHUB_TOKEN=
X_STATE_GITHUB_PATH=x_state.json
X_STATE_GITHUB_BRANCH=main
# --- Execution model ------------------------------------------------------
# queue  = background worker pool  (always-on host, e.g. the Oracle VM)  <- use this
# inline = capture runs inside the HTTP request (scale-to-zero host, e.g. Cloud Run)
EXECUTION_MODE=queue

# --- Paths ----------------------------------------------------------------
# Where job working dirs, outputs and jobs.db live. In Docker these are the
# image paths (/app/data, /app/sessions) that docker-compose mounts over; the
# values below are for running outside Docker.
DATA_DIR=./data
SESSIONS_DIR=./sessions

# --- Server ---------------------------------------------------------------
# The image defaults to 8000.
PORT=8000
