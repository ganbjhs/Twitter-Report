# ---------------------------------------------------------------------------
# Report Automation — configuration
#
# Copy this file to `.env` and edit. NEVER commit `.env`.
#     cp .env.example .env
#
# Anything set as a real environment variable wins over this file.
# ---------------------------------------------------------------------------

# --- Who can log in -------------------------------------------------------
# One "username:password" pair per colleague, comma-separated.
#     APP_USERS=alice:pw1,bob:pw2
# A bcrypt hash is detected automatically, so this also works:
#     APP_USERS=alice:$2b$12$....
APP_USERS=admin:change-me-now

# Single-account alternative, if you prefer two plain variables:
# APP_USER=admin
# APP_PASS=change-me-now

# --- Session signing ------------------------------------------------------
# Long random string. Changing it logs everyone out.
#     python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to 1 once you serve over HTTPS (i.e. once Caddy has your domain).
# Leave 0 while testing over plain http://<server-ip>:8000.
COOKIE_SECURE=0

# How long a login lasts, in hours.
SESSION_HOURS=12


# --- The shared X capture account -----------------------------------------
# The server signs in to X itself and refreshes sessions/x_state.json when it
# expires. Use a DEDICATED / throwaway X account, never a personal one — bulk
# captures can get an account rate-limited or suspended.
X_USERNAME=
X_PASSWORD=
# X asks for the account's email on a login from an unfamiliar machine, which a
# server always is. Set it.
X_EMAIL=
# Only if that account has 2FA turned on (simpler: turn 2FA off on it).
X_TOTP_SECRET=


# --- Capture performance --------------------------------------------------
# Chromium runs on this server, so the limit is your RAM and cores.
# Rule of thumb: one worker per 1-1.5 GB of free RAM (a browser is ~0.5-1 GB).
#     4 GB VPS  -> WORKERS=2
#     8 GB VPS  -> WORKERS=5
WORKERS=2

# How many reports run at once. Total browsers = MAX_CONCURRENT_JOBS x WORKERS.
MAX_CONCURRENT_JOBS=1

# The Influencer report caches each author's follower count per worker PROCESS,
# so extra workers re-fetch the same profiles. Leave at 1 unless your lists
# rarely repeat an account.
INFLUENCER_WORKERS=1

# Hard ceiling on one job, in minutes.
JOB_TIMEOUT_MINUTES=90


# --- Upload limits --------------------------------------------------------
MAX_UPLOAD_MB=5
MAX_LINKS=200


# --- Disk retention -------------------------------------------------------
# Finished jobs are deleted after this many days, and oldest-first once the
# jobs folder exceeds MAX_DATA_GB.
RETENTION_DAYS=7
MAX_DATA_GB=5


# --- Execution model ------------------------------------------------------
# queue  = background workers, status polled by the UI  <- use this on a server
# inline = capture runs inside the HTTP request. Only needed on hosts that stop
#          the CPU once a response is sent (scale-to-zero platforms).
EXECUTION_MODE=queue


# --- Paths ----------------------------------------------------------------
# In Docker these are container paths that docker-compose bind-mounts to
# ./data and ./sessions on the host. Outside Docker they are relative to the
# project folder.
DATA_DIR=./data
SESSIONS_DIR=./sessions


# --- Server ---------------------------------------------------------------
PORT=8000
